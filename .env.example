# --- Acceso a la web ---
APP_PASSWORD=cambia-esto-por-una-contraseña-larga
PORT=3000
HOST=0.0.0.0

# --- Web Push (genera las claves con: npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- Vinted ---
VINTED_DOMAIN=www.vinted.es
# Segundos entre comprobaciones de cada monitor (se aplica ±20 % aleatorio).
# Se puede cambiar después desde Ajustes.
POLL_INTERVAL_SECONDS=45
# Pausa mínima entre dos peticiones cualesquiera a Vinted (ms).
VINTED_MIN_GAP_MS=1500
# VINTED_USER_AGENT=Mozilla/5.0 ...

# --- Otros ---
# Zona horaria para el horario silencioso.
TZ=Europe/Madrid
DB_PATH=./data/sniper.db
# Pon false si NO hay un proxy inverso (Caddy, Cloudflare Tunnel...) delante.
TRUST_PROXY=true
